# FarmSathi Application Environment Configuration

# Core Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=FarmSathi
API_V1_STR=/api/v1

# Security & Tokens
SECRET_KEY=farmsathi_dev_secret_key_super_secure_replace_in_prod_12345
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 18)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/farmsathi_v2_db
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/farmsathi_v2_db

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage
STORAGE_DIR=./storage/uploads

# Machine Learning & Diagnostic Settings
CROP_MODEL_PATH=./ml/models/crop_rf_model.joblib
DISEASE_MODEL_PATH=./ml/models/disease_model.pth
DISEASE_CONFIDENCE_THRESHOLD=0.70

# External Providers
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
